{
  "name": "telegram-digest-bot-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot MVP that monitors public channels and generates LLM digests.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "telegram:login": "tsx src/scripts/generate-session.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "dotenv": "^16.6.1",
    "pino": "^9.11.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
